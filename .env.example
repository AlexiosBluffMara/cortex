# Cortex environment configuration. Copy to .env and fill in.

# --- Ollama ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Gemma 4 model tags (NO Gemma 3 fallback)
GEMMA_FAST_MODEL=gemma4:e4b
GEMMA_DEEP_MODEL=gemma4:26b
GEMMA_EXPERT_MODEL=gemma4:31b

# --- TRIBE v2 -------------------------------------------------------------
TRIBE_WEIGHTS_DIR=./tribev2_weights
TRIBE_MAX_DURATION_S=50
# Do NOT override duration_trs; pipeline.py enforces 100 TRs at 2Hz.

# --- Discord (optional) ---------------------------------------------------
DISCORD_BOT_TOKEN=

# --- WhatsApp (optional, via Hermes Agent) --------------------------------
WHATSAPP_PHONE=

# --- GCP backup (optional) ------------------------------------------------
GCP_PROJECT_ID=
GCP_GCS_BUCKET=
GCP_REGION=us-central1
GCP_GEMMA_ENDPOINT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- External LLM fallback (when GPU is busy with TRIBE) -----------------
FALLBACK_LLM_ENDPOINT=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gpt-4o-mini

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON=true

# --- Web server -----------------------------------------------------------
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8765

# --- HuggingFace (for Unsloth fine-tuning) -------------------------------
HF_TOKEN=
HF_REPO=RedTeamKitchen/cortex-gemma-4-e4b
