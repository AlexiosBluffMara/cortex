{
  "hosting": {
    "site": "abm-isu",
    "public": "gcp/relay/public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "cortex-relay",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache, no-store"}]
      }
    ]
  }
}
