{
  "name": "cortex-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Stripe Checkout + webhook receiver Worker for redteamkitchen.com",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --env=staging",
    "deploy:staging": "wrangler deploy --env=staging",
    "deploy": "wrangler deploy --env=production",
    "tail": "wrangler tail --env=production",
    "kv:create": "wrangler kv:namespace create rtk-customers --env=production",
    "kv:create:staging": "wrangler kv:namespace create rtk-customers --env=staging",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.90.0"
  }
}
